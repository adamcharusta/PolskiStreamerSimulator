{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "securityHeaders.ts",
    "vitest.config.ts",
    "orval.config.ts",
    "playwright.config.ts",
    "playwright.production.config.ts",
    "e2e"
  ]
}
